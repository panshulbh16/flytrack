// Copy to Secrets.xcconfig (gitignored) and fill in. Nothing in this file is a real secret.
// DEVELOPMENT_TEAM is the 10-character Apple Team ID from developer.apple.com/account.
// FLYTRACK_BUNDLE_ID must match the App Store Connect record.
// GOOGLE_IOS_CLIENT_ID is the iOS OAuth client. GOOGLE_WEB_CLIENT_ID is the same web client
// the Android app uses; Supabase Auth checks the ID token against it.
// REVERSED_GOOGLE_CLIENT_ID is the iOS client id reversed (the Google Sign-In URL scheme),
// for example com.googleusercontent.apps.123-abc.
DEVELOPMENT_TEAM = ABCDE12345
FLYTRACK_BUNDLE_ID = app.heygate.flytrack
SUPABASE_URL = https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY = YOUR_ANON_KEY
GOOGLE_IOS_CLIENT_ID = YOUR_IOS_CLIENT_ID.apps.googleusercontent.com
GOOGLE_WEB_CLIENT_ID = YOUR_WEB_CLIENT_ID.apps.googleusercontent.com
REVERSED_GOOGLE_CLIENT_ID = com.googleusercontent.apps.YOUR_IOS_CLIENT_ID
