<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Android 13+: asked at runtime by the push feature before alerts can be shown. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Expedited sync work can be promoted to a short foreground service so the Room write finishes. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SHORT_SERVICE" />

    <!-- Package visibility for the battery-saver screens on the phones that kill background apps. -->
    <queries>
        <package android:name="com.miui.securitycenter" />
        <package android:name="com.vivo.permissionmanager" />
        <package android:name="com.iqoo.secure" />
        <package android:name="com.coloros.safecenter" />
        <package android:name="com.oppo.safe" />
        <package android:name="com.oneplus.security" />
        <package android:name="com.oplus.securitypermission" />
        <package android:name="com.samsung.android.lool" />
    </queries>

    <!--
      MapLibre declares both location permissions for its "my location" layer. FlyTrack shows flights,
      not the user, so they are removed: the app must not appear to want the user's location.
    -->
    <uses-permission
        android:name="android.permission.ACCESS_FINE_LOCATION"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.ACCESS_COARSE_LOCATION"
        tools:node="remove" />

    <application
        android:name=".FlyTrackApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.FlyTrack">

        <!-- singleTop: a tapped notification or a share reaches the running activity through onNewIntent. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- FCM alert notifications carry click_action "OPEN_FLIGHT" (notify.ts) plus the extra "flight_id". -->
            <intent-filter>
                <action android:name="OPEN_FLIGHT" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>

            <!-- "Share to FlyTrack": a ticket PDF, a screenshot or the text of a booking e-mail/SMS. -->
            <intent-filter android:label="@string/app_name">
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="image/*" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter android:label="@string/app_name">
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="application/pdf" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>

        <service
            android:name=".push.FlyTrackMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Used by Play services for alert notifications that do not name a channel, and while the app is dead. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="@string/fcm_default_channel_id" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notification" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/plum" />

        <!--
          Ticket import. PdfRenderer and reading shared/picked files need no permission (content Uris).
          The ML Kit Latin text recogniser is bundled in the APK (com.google.mlkit:text-recognition), so
          OCR works offline from the first start; this entry only matters if it is ever swapped for
          the Play-services (downloaded) model.
        -->
        <meta-data
            android:name="com.google.mlkit.vision.DEPENDENCIES"
            android:value="ocr" />

        <!-- WorkManager is initialised on demand by FlyTrackApp (Configuration.Provider) with the Hilt worker factory. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    </application>
</manifest>
