    <string name="friends_flight_of">%1$s की फ़्लाइट</string>

    <string name="friends_share_title">दोस्तों को दिखाएँ</string>
    <string name="friends_share_on">आपके दोस्त यह फ़्लाइट देख सकते हैं और इसके अलर्ट पा सकते हैं</string>
    <string name="friends_share_off">आपके दोस्तों से छिपी हुई</string>
