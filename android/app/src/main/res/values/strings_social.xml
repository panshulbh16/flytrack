<?xml version="1.0" encoding="utf-8"?>
<!-- P3 social: Passport compare (B10), Passport sharing, crew mode (B12). Every name starts with social_. -->
<resources>
    <!-- Settings -->
    <string name="social_section">Sharing and crew</string>
    <string name="social_share_passport_title">Share my Passport with friends</string>
    <string name="social_share_passport_message">Friends can compare their flight totals with yours. They never see your flights or bookings.</string>
    <string name="social_crew_title">Crew mode</string>
    <string name="social_crew_message">For pilots and cabin crew: check-in, boarding and when-to-leave alerts are muted, Pro offers are hidden, flights show block times and Passport counts block hours.</string>
    <string name="social_crew_muted">Muted in crew mode: check-in, boarding and when-to-leave alerts. Delay, gate and cancellation alerts still arrive.</string>
    <string name="social_message_offline">You\'re offline, so that didn\'t change. Try again when you\'re connected.</string>
    <string name="social_message_failed">That didn\'t change. Please try again.</string>

    <!-- Passport, crew mode -->
    <string name="social_passport_tile_block_hours">Block hours</string>

    <!-- Compare Passports -->
    <string name="social_compare_action">Compare Passports</string>
    <!-- %1$s is the friend\'s name -->
    <string name="social_compare_title">You vs %1$s</string>
    <string name="social_compare_tab_overview">Overview</string>
    <!-- %1$d is the current year -->
    <string name="social_compare_tab_year">%1$d</string>
    <string name="social_compare_you">You</string>
    <string name="social_compare_vs">vs</string>
    <string name="social_compare_error">We couldn\'t load the comparison</string>
