    <string name="social_compare_not_shared_title">%1$s isn\'t sharing their Passport</string>
    <string name="social_compare_not_shared_message">%1$s can turn on \"Share my Passport with friends\" in Settings. Then you can compare.</string>
    <string name="social_compare_last12_note">Both sides count the last 12 months. Pro compares all time.</string>
    <string name="social_compare_flights">Flights</string>
    <string name="social_compare_km">Kilometres</string>
    <string name="social_compare_airports">Airports</string>
    <string name="social_compare_countries">Countries</string>
    <string name="social_compare_longest_km">Longest flight, km</string>
