<?xml version="1.0" encoding="utf-8"?>
<!-- Round-safe: the content stays inside the inscribed square (14% inset on each side). -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/wear_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="@dimen/wear_inset"
        android:paddingTop="@dimen/wear_inset"
        android:paddingEnd="@dimen/wear_inset"
        android:paddingBottom="@dimen/wear_inset">

        <TextView
            android:id="@+id/flight_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/wear_ink"
            android:textSize="20sp"
            android:fontFamily="serif" />

        <TextView
            android:id="@+id/flight_route"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center"
            android:textColor="@color/wear_ink"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/flight_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:textSize="15sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/flight_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:textColor="@color/wear_muted"
            android:textSize="14sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/flight_gate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center"
            android:textColor="@color/wear_muted"
            android:textSize="14sp"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
