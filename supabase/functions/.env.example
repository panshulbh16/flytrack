# Copy to supabase/functions/.env for `supabase functions serve --env-file`.
# For production use:  supabase secrets set --env-file supabase/functions/.env
# NEVER commit the real .env.

FLIGHT_PROVIDER=mock               # mock | aerodatabox
# generate secrets with:  openssl rand -hex 32   (hex = safe in headers and URLs)
CRON_SECRET=change-me-long-random  # must match vault secret 'cron_secret'
WEBHOOK_SECRET=change-me-too       # token in the provider-webhook URL
PUSH_DRY_RUN=true                  # LOCAL ONLY. Remove in production (set FCM_SERVICE_ACCOUNT_JSON instead)

# AeroDataBox (when FLIGHT_PROVIDER=aerodatabox)
ADB_API_KEY=
ADB_BASE_URL=https://aerodatabox.p.rapidapi.com
ADB_KEY_HEADER=X-RapidAPI-Key
ADB_HOST_HEADER=aerodatabox.p.rapidapi.com
ADB_WEBHOOKS=false

# Firebase service account JSON on ONE line (Firebase console → Project settings → Service accounts)
FCM_SERVICE_ACCOUNT_JSON=

# Ticket text parsing (parse-ticket). Never log the ticket text. Haiku 5.5, Sonnet 5.5 fallback.
ANTHROPIC_API_KEY=
